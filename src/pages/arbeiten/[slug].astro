---
/**
 * Detailseite einer Case Study ( /arbeiten/<dateiname>/ )
 * Für jede Datei in src/content/case-studies/ wird automatisch eine Seite erzeugt.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const eintraege = await getCollection('case-studies');
  return eintraege.map((eintrag) => ({
    params: { slug: eintrag.id },
    props: { eintrag },
  }));
}

interface Props {
  eintrag: CollectionEntry<'case-studies'>;
}

const { eintrag } = Astro.props;
const { title, kurzbeschreibung, firma, zeitraum, rolle, team, tags, cover, coverAlt } = eintrag.data;
const { Content } = await render(eintrag);
---

<BaseLayout title={title} description={kurzbeschreibung} ogType="article">
  <article class="container section">
    <p><a href="/arbeiten/">← Alle Arbeiten</a></p>
    <header class="prose">
      <h1>{title}</h1>
      <p class="lead">{kurzbeschreibung}</p>
    </header>

    <dl class="fakten">
      <div><dt>Firma</dt><dd>{firma}</dd></div>
      <div><dt>Zeitraum</dt><dd>{zeitraum}</dd></div>
      <div><dt>Rolle</dt><dd>{rolle}</dd></div>
      <div><dt>Team</dt><dd>{team}</dd></div>
    </dl>

    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Schlagworte">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }

    {cover && <Image class="cover" src={cover} alt={coverAlt ?? ''} />}

    <div class="prose inhalt">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .fakten {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-4);
    margin: var(--space-6) 0;
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  .fakten dt {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .fakten dd {
    margin: 0;
    font-weight: var(--font-weight-bold);
  }

  .cover {
    margin-block: var(--space-6);
    border-radius: var(--radius-md);
  }

  .inhalt {
    margin-top: var(--space-6);
  }
</style>
