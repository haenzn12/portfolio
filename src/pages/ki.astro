---
/**
 * "Wie ich mit KI arbeite" ( /ki/ )
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TodoHinweis from '../components/TodoHinweis.astro';
---

<BaseLayout
  title="Wie ich mit KI arbeite"
  description="Wie Hannah Zobel KI im Designprozess einsetzt. (Platzhalter)"
>
  <div class="container section prose">
    <h1>Wie ich mit KI arbeite</h1>
    <p class="lead">Platzhalter: Einleitung, welche Rolle KI in meiner Arbeit spielt.</p>

    <h2>Diese Website als Beispiel</h2>
    <TodoHinweis titel="Platzhalter">
      Wie diese Website mit KI-Unterstützung entstanden ist: Vorgehen, Werkzeuge, was ich selbst
      entschieden habe.
    </TodoHinweis>

    <h2>Mein KI-Workflow</h2>
    <TodoHinweis titel="Platzhalter">
      In welchen Phasen des Designprozesses ich KI einsetze und wo bewusst nicht.
    </TodoHinweis>

    <h2>Highlights</h2>
    <TodoHinweis titel="Platzhalter">Konkrete Beispiele und Ergebnisse.</TodoHinweis>
  </div>
</BaseLayout>
